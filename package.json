{
  "name": "ttr-one",
  "version": "0.1.0",
  "private": true,
  "description": "TTR ONE — Enterprise ERP Platform (foundation MVP)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "tsx scripts/db-setup.ts",
    "test": "tsx scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "^18.4.0-beta.17",
    "@embedded-postgres/darwin-arm64": "^18.4.0-beta.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}
