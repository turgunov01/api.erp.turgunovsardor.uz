# ---------------------------------------------------------------------------
# TTR ONE — docker-compose environment. Copy to `.env` and fill real values:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- Postgres (the `postgres` compose service) ----
POSTGRES_USER=ttr
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ttr_one

# ---- API (the `api` compose service) ----
# Points at the compose `postgres` service on the internal network.
DATABASE_URL=postgresql://ttr:change-me-strong-db-password@postgres:5432/ttr_one?schema=public

# Secrets — generate with:  openssl rand -hex 32
JWT_SECRET=change-me-min-16-chars-please-use-32
SECRET_KEY=change-me-another-32-byte-random-secret

# CORS: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080

# Public base URL of the API (used for password-reset links etc.)
APP_URL=http://localhost:3000

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Seed admin (used by db:seed only)
SEED_ADMIN_EMAIL=admin@demo-factory.com
SEED_ADMIN_PASSWORD=Admin123!

# ---- Web (the `web` compose service, baked in at build time) ----
# Where the browser reaches the API. For local compose this is the host-mapped
# API port; behind an ingress use the public https URL + /api/v1.
NUXT_PUBLIC_API_BASE=http://localhost:3000/api/v1

# ---- Optional integrations (leave blank if unused) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
SMTP_URL=
TELEGRAM_BOT_TOKEN=
